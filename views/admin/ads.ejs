<%- include('_top') %>
<h1>Reklam Yönetimi</h1>
<form method="post" action="/yonetim/reklamlar/alan" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2 style="font-size:1.05rem">Reklam alanları</h2>
  <p class="small muted">"Doğrudan" = sizin sattığınız bölge hedefli reklamlar. "AdSense" = Google reklamı (yalnızca reklam çerezine izin veren ziyaretçilere gösterilir; .env dosyasında ADSENSE_CLIENT tanımlı olmalı).</p>
  <label class="check"><input type="checkbox" name="adsense_enabled" value="1" <%= adsenseEnabled ? 'checked' : '' %>> <span>Google AdSense etkin</span></label>
  <div class="table-wrap"><table class="t"><thead><tr><th>Alan</th><th>Mod</th><th>AdSense slot no</th></tr></thead><tbody>
  <% for (const sl of slots) { %>
    <tr><td><%= SLOTS[sl.key] || sl.key %></td>
      <td><select name="mode_<%= sl.key %>" style="min-height:42px;padding:4px 34px 4px 10px"><% for (const [m, lab] of [['house','Doğrudan'],['adsense','AdSense'],['off','Kapalı']]) { %><option value="<%= m %>" <%= sl.mode === m ? 'selected' : '' %>><%= lab %></option><% } %></select></td>
      <td><input name="slot_<%= sl.key %>" value="<%= sl.adsense_slot_id || '' %>" style="min-height:42px;padding:6px 10px" placeholder="1234567890"></td></tr>
  <% } %>
  </tbody></table></div>
  <button class="btn btn-primary" style="margin-top:12px">Kaydet</button>
</form>

<form method="post" action="/yonetim/reklamlar/yeni?_csrf=<%= csrf %>" enctype="multipart/form-data" class="card">
  <h2 style="font-size:1.05rem">Yeni doğrudan reklam</h2>
  <div class="grid-2">
    <div class="field"><label for="slot_key">Alan</label><select id="slot_key" name="slot_key"><% for (const [k, v] of Object.entries(SLOTS)) { %><option value="<%= k %>"><%= v %></option><% } %></select></div>
    <div class="field"><label for="advertiser">Reklamveren</label><input id="advertiser" name="advertiser" required></div>
    <div class="field"><label for="title">Başlık</label><input id="title" name="title" maxlength="90" required></div>
    <div class="field"><label for="target_url">Hedef adres (https://)</label><input id="target_url" name="target_url" type="url" required></div>
    <div class="field"><label for="body">Kısa metin</label><input id="body" name="body" maxlength="200"></div>
    <div class="field"><label for="days">Süre (gün)</label><input id="days" name="days" type="number" value="30" min="1" max="365"></div>
  </div>
  <div class="field"><label for="city_codes">Hedef iller <span class="opt">(boş = tüm Türkiye; Ctrl ile çoklu seçim)</span></label>
    <select id="city_codes" name="city_codes" multiple size="6" style="background-image:none"><% for (const c of geo.iller) { %><option value="<%= c.code %>"><%= c.name %></option><% } %></select></div>
  <div class="field"><label for="image">Görsel <span class="opt">(isteğe bağlı, 2:1 oran önerilir)</span></label><input id="image" name="image" type="file" accept="image/*"></div>
  <button class="btn btn-accent"><%- icon('plus') %> Reklamı ekle</button>
</form>

<div class="table-wrap" style="margin-top:16px"><table class="t">
  <thead><tr><th>Reklam</th><th>Alan</th><th>Hedef</th><th>Gösterim / Tık</th><th>Bitiş</th><th></th></tr></thead>
  <tbody>
  <% for (const a of ads) { %>
    <tr>
      <td><strong><%= a.title %></strong><div class="small muted"><%= a.advertiser %></div></td>
      <td class="small"><%= SLOTS[a.slot_key] %></td>
      <td class="small"><%= a.city_codes.length ? a.city_codes.map(c => geo.cityName(c)).join(', ') : 'Tüm Türkiye' %></td>
      <td><%= a.impressions %> / <%= a.clicks %><div class="small muted">TO: <%= a.impressions ? (a.clicks / a.impressions * 100).toFixed(1) : 0 %>%</div></td>
      <td class="small"><%= fmtDate(a.ends_at) %></td>
      <td>
        <form method="post" action="/yonetim/reklamlar/<%= a.id %>" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="toggle"><button class="btn btn-ghost btn-sm"><%= a.active ? 'Durdur' : 'Başlat' %></button></form>
        <form method="post" action="/yonetim/reklamlar/<%= a.id %>" class="inline-form" data-confirm="Reklam silinsin mi?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="delete"><button class="btn btn-danger btn-sm"><%- icon('trash') %></button></form>
      </td>
    </tr>
  <% } %>
  <% if (!ads.length) { %><tr><td colspan="6" class="muted">Henüz doğrudan reklam yok.</td></tr><% } %>
  </tbody>
</table></div>
<%- include('_bottom') %>

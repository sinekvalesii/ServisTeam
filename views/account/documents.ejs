<%- include('../partials/header') %>
<div class="narrow">
  <a class="btn btn-quiet" href="/hesap"><%- icon('back') %> Hesabım</a>
  <h1>Belge Doğrulama</h1>
  <div class="alert alert-info"><%- icon('lock') %><div>
    <strong>Belgeniz bizde kalmaz.</strong> Ekibimiz belgenizi e-Devlet üzerinden kontrol eder, ardından belge bilgileri <strong>en geç 7 gün içinde otomatik silinir</strong>. Sistemde yalnızca "doğrulandı" bilgisi ve tarih saklanır.
  </div></div>

  <% if (items.length) { %>
  <div class="card">
    <h2 style="font-size:1.1rem">Başvurularım</h2>
    <% for (const i of items) { %>
      <div style="display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)">
        <div><strong><%= tax.DOC_TYPES[i.doc_type].label %></strong><div class="small muted"><%= fmtDate(i.created_at) %><%= i.reject_reason ? ' · ' + i.reject_reason : '' %></div></div>
        <span class="tag <%= {approved:'tag-green',rejected:'tag-red',pending:'',expired:'tag-gray'}[i.status] %>"><%= {approved:'Onaylandı',rejected:'Onaylanmadı',pending:'İnceleniyor',expired:'Süresi doldu'}[i.status] %></span>
      </div>
    <% } %>
  </div>
  <% } %>

  <div class="card">
    <h2>Yeni belge gönder</h2>
    <form method="post" action="/hesap/belgeler?_csrf=<%= csrf %>" enctype="multipart/form-data" novalidate data-doc-form>
      <div class="field">
        <label for="doc_type">Belge türü</label>
        <select id="doc_type" name="doc_type" required>
          <option value="">Seçin</option>
          <% for (const [k, d] of Object.entries(tax.DOC_TYPES)) { %><option value="<%= k %>" <%= form.doc_type === k ? 'selected' : '' %>><%= d.label %><%= suggested.includes(k) ? ' (önerilen)' : '' %></option><% } %>
        </select>
        <% if (errors.doc_type) { %><div class="err-text"><%= errors.doc_type %></div><% } %>
      </div>
      <div class="field">
        <span class="label">Nasıl doğrulayalım?</span>
        <div class="choices">
          <label class="choice"><input type="radio" name="method" value="barkod" <%= form.method !== 'dosya' ? 'checked' : '' %>><span class="box"><%- icon('shield') %><span><strong>e-Devlet barkodu ile (önerilen)</strong><span>e-Devlet'ten belgenin barkodlu çıktısını alın, barkod numarasını yazın. Fotoğraf gerekmez.</span></span></span></label>
          <label class="choice"><input type="radio" name="method" value="dosya" <%= form.method === 'dosya' ? 'checked' : '' %>><span class="box"><%- icon('camera') %><span><strong>Fotoğraf yükleyerek</strong><span>Barkodu olmayan belgeler için. Fotoğraf şifreli saklanır, inceleme sonrası silinir.</span></span></span></label>
        </div>
      </div>
      <div data-method="barkod">
        <div class="field">
          <label for="barcode">Barkod / doğrulama numarası</label>
          <input id="barcode" name="barcode" type="text" autocomplete="off" value="<%= form.barcode || '' %>" placeholder="Örn. EGM-1A2B3C4D5E6F7G8H">
          <div class="hint">Belgenin sağ üst köşesindeki numara.</div>
          <% if (errors.barcode) { %><div class="err-text"><%= errors.barcode %></div><% } %>
        </div>
        <div class="field">
          <label for="tckn">T.C. Kimlik No</label>
          <input id="tckn" name="tckn" type="text" inputmode="numeric" maxlength="11" autocomplete="off">
          <div class="hint">e-Devlet belge doğrulaması barkodla birlikte kimlik numarası ister. Şifreli tutulur, kontrol sonrası silinir.</div>
          <% if (errors.tckn) { %><div class="err-text"><%= errors.tckn %></div><% } %>
        </div>
      </div>
      <div data-method="dosya" hidden>
        <div class="field">
          <label for="file">Belge fotoğrafı veya PDF</label>
          <input id="file" name="file" type="file" accept="image/jpeg,image/png,application/pdf">
          <div class="hint">En fazla 6 MB. Kimlik numaranız dışındaki gereksiz bilgileri kapatabilirsiniz.</div>
          <% if (errors.file) { %><div class="err-text"><%= errors.file %></div><% } %>
        </div>
      </div>
      <label class="check"><input type="checkbox" name="consent" value="1" required> <span>Belgemin doğrulanması amacıyla belge bilgilerimin ve T.C. kimlik numaramın işlenmesine <strong>açık rıza</strong> veriyorum. Bilgilerin inceleme sonrası silineceğini biliyorum. <a href="/sayfa/kvkk" target="_blank">Ayrıntılar</a></span></label>
      <% if (errors.consent) { %><div class="err-text"><%= errors.consent %></div><% } %>
      <button class="btn btn-primary btn-block" type="submit" style="margin-top:10px">Doğrulamaya Gönder</button>
    </form>
  </div>
  <p class="small muted">Adli sicil kaydı gibi ceza mahkûmiyeti bilgisi içeren belgeler <strong>özel nitelikli kişisel veri</strong> olduğundan sitemizde istenmez ve işlenmez. İşverenler bu belgeyi işe alım sürecinde doğrudan talep etmelidir.</p>
</div>
<%- include('../partials/footer') %>

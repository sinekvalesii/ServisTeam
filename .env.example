# ======== ZORUNLU ========
BASE_URL=https://servisteam.com
POSTGRES_PASSWORD=buraya-uzun-rastgele-bir-sifre
# Üretmek için: openssl rand -hex 32
SESSION_SECRET=
# Üretmek için: openssl rand -hex 32   (KAYBETMEYİN: bekleyen belge doğrulamaları bununla şifrelenir)
DATA_ENCRYPTION_KEY=

# ======== E-POSTA (doğrulama kodları) ========
# Türkiye'de barındırılan bir kurumsal e-posta / SMTP hizmeti önerilir
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Servis Team <no-reply@servisteam.com>

# ======== ŞİRKET BİLGİLERİ (yasal metinlerde görünür) ========
COMPANY_TITLE=
COMPANY_ADDRESS=
COMPANY_EMAIL=destek@servisteam.com
COMPANY_KEP=
COMPANY_MERSIS=

# ======== AKARYAKIT ========
# api: hasanadiguzel.com.tr API'sinden 2 saatte bir çekilir | manual: yalnızca admin girişi
FUEL_PROVIDER=api

# ======== REKLAM ========
# Google AdSense onaylandıktan sonra: ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_CLIENT=

# ======== SMS (ileride, isteğe bağlı) ========
SMS_PROVIDER=console
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
